*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.ptx
*.cubin
*.fatbin

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
/dist/
/wheelhouse/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ── Editors / OS ────────────────────────────────────
.vscode/
.idea/
.cache/
*.swp
*~
.DS_Store
